{
  "appId": "com.absolutefreakout.radiolla",
  "productName": "Radiolla",
  "directories": {
    "output": "release",
    "app": ".electron-app"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/**/*",
    "package.json",
    "!node_modules{,/**/*}"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": "x64"
      }
    ],
    "artifactName": "Radiolla-Setup-${version}-${arch}.${ext}"
  },
  "fileAssociations": [
    {
      "ext": [
        "mp3",
        "aac",
        "m4a",
        "wav",
        "ogg",
        "flac"
      ],
      "name": "Audio file",
      "description": "Audio file opened with Radiolla",
      "role": "Viewer"
    }
  ],
  "nsis": {
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  },
  "npmRebuild": false
}
